{#
  Shared assessment section navigation (service header and optional side nav).
  Toggle side nav: set showAssessmentSideNav to true in app/config.json
#}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{% set assessmentNavSections = [
  { id: "home", label: "Home" },
  { id: "section-1", label: "Tiering", showComplete: true },
  { id: "strengths-and-needs", label: "Strengths and needs" },
  { id: "rosh", label: "Risk of serious harm" },
  { id: "risk-management-plan", label: "Risk management plan" },
  { id: "sentence-plan", label: "Sentence plan" }
] %}

{% macro renderServiceNavigation(activeSection, useReoffendingNav) %}
  {# Single-line markup – line breaks in the HTML force the tick onto a new row #}
  {% set sectionNavLabel = "Reoffending" if useReoffendingNav else "Tiering" %}
  {% set sectionNavHtml %}<span class="assessment-section-navigation__label">{{ sectionNavLabel }}</span><span class="assessment-section-navigation__complete-icon" data-section-complete="section-1" aria-hidden="true"><svg class="assessment-section-navigation__tick" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="12" fill="#1d70b8"/><path fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M7 12.5 10 15.5 17 8.5"/></svg></span>{% endset %}

  {% if useReoffendingNav %}
  {{ govukServiceNavigation({
    classes: "assessment-service-navigation assessment-section-navigation",
    navigation: [
      {
        text: "Home",
        href: "#",
        current: activeSection == "home",
        attributes: { "data-section": "home" }
      },
      {
        html: sectionNavHtml | trim,
        href: "#",
        current: activeSection == "section-1",
        attributes: { "data-section": "section-1" }
      }
    ]
  }) }}
  {% else %}
  {{ govukServiceNavigation({
    classes: "assessment-service-navigation assessment-section-navigation",
    navigation: [
      {
        text: "Home",
        href: "#",
        current: activeSection == "home",
        attributes: { "data-section": "home" }
      },
      {
        html: sectionNavHtml | trim,
        href: "#",
        current: activeSection == "section-1",
        attributes: { "data-section": "section-1" }
      },
      {
        text: "Strengths and needs",
        href: "#",
        attributes: { "data-section": "strengths-and-needs" }
      },
      {
        text: "Risk of serious harm",
        href: "#",
        attributes: { "data-section": "rosh" }
      },
      {
        text: "Risk management plan",
        href: "#",
        attributes: { "data-section": "risk-management-plan" }
      },
      {
        text: "Sentence plan",
        href: "#",
        attributes: { "data-section": "sentence-plan" }
      }
    ]
  }) }}
  {% endif %}
{% endmacro %}

{% macro renderSideNavigation(activeSection) %}
<nav class="moj-side-navigation assessment-side-navigation assessment-section-navigation" aria-label="Assessment sections">
  <ul class="moj-side-navigation__list">
    {% for section in assessmentNavSections %}
    <li class="moj-side-navigation__item{% if activeSection == section.id %} moj-side-navigation__item--active{% endif %}">
      <a href="{{ section.href | default("#") }}" class="assessment-section-navigation__link" data-section="{{ section.id }}"{% if activeSection == section.id %} aria-current="location"{% endif %}>
        <span class="assessment-section-navigation__label">{{ section.label }}</span>
        {% if section.showComplete %}
        <span class="assessment-section-navigation__complete-icon" data-section-complete="{{ section.id }}" aria-hidden="true">
          <svg class="assessment-section-navigation__tick" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="12" fill="#1d70b8"/>
            <path fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M7 12.5 10 15.5 17 8.5"/>
          </svg>
        </span>
        {% endif %}
      </a>
    </li>
    {% endfor %}
  </ul>
</nav>
{% endmacro %}
